<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\ZenohNative.targets" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\YuukoProtocol\YuukoProtocol.csproj" />
  </ItemGroup>

  <!-- The self-test models an attacker with a stolen identity, so it calls Pariah (Kyber) directly. -->
  <ItemGroup>
    <Reference Include="PariahCybersecurity">
      <HintPath>..\libs\PariahCybersecurity.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
